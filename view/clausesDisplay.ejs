</head>

<body>
    <div class='containerOfAll'>

        <nav style='background-color: #007bff' role="navigation">
            <div class="nav-wrapper">
                <span style='right:20px; z-index:3' class="profile-picture right">
                    <i class='material-icons' style='font-size: 25px'  onclick="Logout()"> logout
                    </i>
            </span>
                <a class="grey-text text-lighten-4 right" href="#!">
                    <i class="material-icons right" style='color:white; margin-right: 16px'>
                    <i id='addClause' style='font-size: 2.4rem;  margin-right: 16px' class="material-icons">add</i>
                    </i>
                </a>
                <span id='Sfl_teacher_settings' style='right:40px; margin-top:7px; z-index: 3; display:none' class="profile-picture right">
                <i id='sfl_teacher_set_icon' class='material-icons' style='font-size: 25px'>visibility
                </i>
            </span>
                <span id='mode' class='right' style='margin-right:60px; margin-top:7px; z-index: 3; display:none'>
                <a class="tooltipped" data-position="bottom"
                    data-tooltip="Change to Edit mode to change your sample answer">
                    <i style='font-size : 16px'>(View Mode)</i>
                </a>
            </span>
                <div class="container" style='width:100%; margin-left:16px'>
                    <div class='left' style='font-family: "Roboto", Arial, sans-serif"'>
                        <a href="/views/dashboard" class="breadcrumb returnToDash">Dashboard</a>
                        <a href="#" class="breadcrumb">Clause Analysis</a>
                    </div>
                </div>
            </div>


        </nav>
        <div id='messageEl' style='display: none; margin-top: 5px;' class="alert-block alert-success">This has been attempted before.</div>
        <table id="putcontentshere" style='margin-top:-1px'>
            <tr>
                <th>Tools</th>
                <th>Clause List</th>
            </tr>
        </table>
        <div oninput="getSentence()" class='container text-lighten-4' style='text-align: left'>
        </div>
        <!-- This is the panel that appears when user clicks on a sentence/clause -->
        <div id='panel2'>
            <!--<button id="closePanel2" class="w3-button w3-red w3-right w3-large"><i class="fa fa-close"></i></button>-->
            <i id='closePanel2' style='position: absolute; right:10px' class="material-icons">close</i>

            <h4 id='analysisTableHeading'>Analysis Table</h4>

                         <ul class="tabs btn-group btn-grp">
                <li id="MarkupButton" style="flex: 1;" class="w3-bar-item w3-button tablink active tab col s3"
                    onclick="openLink(event, 'Markup');">
                    <a href='#' class='active'>
                        <i class="fa fa-pencil-square-o w3-margin-right"></i>Analysis</a>
                </li>
                <li id="TreeButton" style="flex: 1;" class="w3-bar-item w3-button tablink tab col s3"
                    onclick="openLink(event, 'Tree');">
                    <a>
                        <i class="fa fa-tree w3-margin-right"></i>Tree</a>
                </li>
                <li id='OtherButton' style="flex: 1;" class="w3-bar-item w3-button tablink tab col s3"
                    onclick="openLink(event, 'Other');">
                    <a>
                        <i class="fa fa-code w3-margin-right"></i>Other</a>
                </li>

            </ul> 

            <!-- Tabs -->
            <div id="Tabs">
                <div id="Markup" class="myLink">
                    <div style="background-color: #e3e1dc; padding: 5px; margin-top: 5%;">
                        <h5 id="sentence2"></h5>
                    </div>
                    <br>
                    <!-- Output selected sentence -->

                    <!-- table buttons -->

                    <div id='ButtonsOfTable' style=" z-index: 2; display: flex; ">
                        <div style='display: -webkit-box; width:68%'>
                            <i id='undoButton' onclick="undoTableOp()" title="Undo" class="material-icons table-buttons">undo</i>
                            <i id='addRowButton' onclick="addRow()" title="Add Row" class="material-icons table-buttons">add</i>
                            <i id='save' title="Save" class="material-icons table-buttons">save</i>
                            <!-- <i id='gradeSFG'  title="Grade" class="material-icons">grade</i> -->
                            <i id='rootNodeButton' title="Edit Root Node" class="material-icons table-buttons">edit</i>
                            <i id='captionButtom' title="Add translation/Caption" class="material-icons table-buttons">short_text</i>
                            <i id='switchStrand' title="Switch to Three Strand Analysis" class="material-icons table-buttons">chevron_right</i>
                            <i class="material-icons" style="visibility: hidden;">add</i>
                        </div>
                        <div id='TypeOfStrand' style=' float:right;'>One Strand Analysis</div>
                    </div>



                    <!--Merge buttons-->

                    <i id='mergeButton' onclick="mergeSelectedCells()" title="Merge" class="material-icons" style='z-index: 2'>
                        <img src="/Controllers/SFL_Draw/Panel_javascripts/mergeBlack.png"
                            style="width:18px;height:18px;">
                    </i>
                    <i id='unMergeButton' onclick="unMergeSelectedCells()" title="Un-Merge" class="material-icons" style='z-index: 5'>grid_on</i>



                    <!-- Table/Box diargram-->
                    <div id="overflow_table" style='overflow: auto; margin-top: 15px;'>

                        <!-- Edit Root Node Field -->
                        <div id="EditorForRootNode">
                            <div class="EditRootNodeLabel">
                                Edit root node :
                            </div>
                            <div class="EditRootNodeBody">
                                <input id='newRootValue' type="text" value="Clause">
                            </div>
                        </div>

                        <!-- Edit Caption Field -->
                        <div id="EditorForCaption">
                            <div class="EditRootNodeLabel">
                                Add a caption or tranlation to the bottom of the tree :
                            </div>
                            <div class="EditRootNodeBody">
                                <input id='newCaptionValue' type="text">
                            </div>
                        </div>

                        <!--One strand table-->
                        <div style=' z-index: 1'>
                            <div class="col-md-6" style='width: 100%'>
                                <table id="tableId" class="table AnalyseTable table-condensed table-summary table-borderless table-responsive" style='width: 100%'>
                                    <tr></tr>
                                </table>
                                <table id="threeStrandTable" class="table AnalyseTable table-condensed table-summary table-borderless table-responsive" style='width: 100%; display: none'></table>
                            </div>

                            <!-- Comparing tables -->
                            <!-- <div class="col-md-6" style='width: 100%'>
                                <table id='comparedTable'
                                    class="table AnalyseTable table-condensed table-summary table-borderless table-responsive"
                                    style='width: 100%'></table>
                                <table id='comparedTableTST'
                                    class="table AnalyseTable table-condensed table-summary table-borderless table-responsive"
                                    style='width: 100%; display: none'></table>
                            </div> -->
                        </div>

                    </div>
                </div>

                               <div id="Tree" class="myLink" style="overflow: auto">
                    <div id="Tree_list" style="display:none"></div>
                    <div id="TreeArea" style="overflow: auto"></div>
                </div>

                <div id="Other" class="myLink" style="overflow: auto">
                    <div style='padding : 20px'>
                        <a id='DownloadJSON' class="waves-effect waves-light btn" download>
                            <i class="material-icons right">save_alt</i>Export Table HTML
                        </a>
                        <a id='DownloadSFLTree' class="waves-effect waves-light btn" download>
                            <i class="material-icons right">save_alt</i>Export Syntax Tree</a>
                    </div>
                </div> 

            </div>

        </div>

        <!-- shows who has annotated, doesn't appear in demo version -->

        <div id='panel'>
            <div class="container">
                <div id='student_list' class="list-group" style="float:left; clear:left; height:50px;">

                </div>
            </div>
        </div>

        <!--This table is never shown but used to annotate both strand tables at once-->
        <table id='combinedTable' style='display: none'></table>

