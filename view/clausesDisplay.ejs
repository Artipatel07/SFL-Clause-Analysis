        </nav> -->
    </div>

    <div class='card' id='profileCard' style=' width: 230px; position: absolute; top: 70px; right: 20px; z-index: 3;display: none; box-shadow: 0 2px 10px rgba(0,0,0.9);'>
        <ul>
            <li id='changePasswordOption'>
                <a href='javascript:void(0);' style='padding:14px'>Change Password</a>
            </li>
            <li>
                <a href='/logout' style='padding:14px'>Log out</a>
            </li>
        </ul>
    </div>

    <!-- update user details -->
    <div class='card' id='updateUser'>

        <form method='POST' action='/Pic/Profile' enctype="multipart/form-data">
            <span style=' left:46%; top: 10px; font-size:24px ; position: absolute;'>
                <label style="top: unset">
                    <div class="material-icons profile-picture">
                        <img id='editProfilePic' style='width:50px; height:50px; cursor: pointer;'
                            src="/css/classroom_selector/default-user-profile-picture-7.png" />
                    </div>
                    <input name='ProfilePic' id="file-input" onchange="this.form.submit()" type="file" />
                </label>
            </span>
        </form>



        <a href="javascript:void(0);">
            <i id='closeUpdateUser' class="material-icons" style='font-size: 2.2rem; float: right; margin-right: 10px;margin-top: 5px'>close</i>
        </a>

        <div class="input-field" style='margin-top: 50px'>
            <input type="text" name='changeName' id="changeName" value='' readonly />
            <label for="changeName" style='color:#007bff'>Name</label>
            <div class="bar"></div>
        </div>
        <form id='updateUsername'>
            <div class="input-field" style='display:inline-block; width:62%'>
                <input type="text" name='changeUsername' id="changeUsername" value='' required="required" />
                <label for="changeUsername" style='color:#007bff'>Username</label>
            </div>
            <div id='username-error' class='error' style='display:none'>

            </div>
            <button type='submit' id='UsernameUpdate' class='button' style='float:right; margin:20px;'>Update</button>

    </div>

    <div id='changePasswordCard' style='padding:12px; width:458px; position: absolute; top: 12%; left: 25%; z-index: 999; overflow-y: auto; display: none; background-color: white'>
        <div style='font-size:24px'>Change Password
            <a href="javascript:void(0);">
                <i id='closePasswordCard' class="material-icons" style='font-size: 2.2rem; float: right; margin-right: 10px;margin-top: 5px'>close</i>
            </a>
        </div>
        <form id='passwordForm' method='POST' action='/ChangePassword'>
            <!--The email is for authentication purposes only, it is not displayed for users-->
            <input type="email" name='email' id="email" required="required" value='' style='display:none' />
            <div class='input-field'>
                <input type="password" name='password' id="password" required="required" />
                <label for="newPassword" style='color:#007bff'>Old Password</label>
            </div>
            <div class='input-field'>
                <input type="password" name='changePassword' id="newPassword" required="required" />
                <label for="newPassword" style='color:#007bff'>New Password</label>
            </div>

            <div class='input-field'>
                <input type="password" name='changeCPassword' id="newCPassword" required="required" />
                <label for="newCPassword" style='color:#007bff'>Confirm New Password</label>
            </div>


            <button type='submit' id='ConfirmPassword' class='button' style='float:right;'>Update Password</button>
        </form>

    </div>

    <div class='card' id='newClause'>

        <span id='ClauseHeading' style='left:10px; top: 10px; font-size: 24px ; position: absolute;'>New
            Clause</span>
        <a href="javascript:void(0);">
            <i id='closeNewClause' class="material-icons" style='font-size: 1.8rem; float: right; margin-right: 10px;margin-top: 15px'>close</i>
        </a>
        <br /><br /><br />


        <div class="form-step js-form-step" data-step="1">

            <form id='newClauseForm' class="col s12">
                <div id='error-Clause' class='alert-block alert-danger' style='display : none;'> There is an error. </div>

                <div class="row" class='newClauseInputs' style="padding-right: 5%; padding-left: 5%">

                    <div class="input-field">
                        <input type="text" name="clause" id="clause" aria-required="true" required minlength='3' />
                        <label for="clause">Clause</label>
                    </div>

                    <div class="input-field">
                        <input type="text" name="context" id="context" aria-required="true" required minlength='3' />
                        <label for="context">Context</label>
                    </div>

                    <div class="input-field">
                        <label for="context" style="position: relative">Visibility: Private?</label>
                        <input type="checkbox" name="visibility" id="visibility">
                    </div>

                    <button id='ConfirmCreateClause' type="submit" class="btn waves-effect waves-light btn-small" style='background-color: #4CAF50;float:right; margin-top:5px;'>Submit
                        <i class="material-icons right">send</i>
                    </button>
                </div>
            </form>

        </div>
    </div>
    <div id='overlay'></div>
</body>

