<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>


    <link rel="stylesheet" href="/css/SFL_Draw/materialize/css/materialize.min.css">
    <link rel='stylesheet' href='https://fonts.googleapis.com/icon?family=Material+Icons'>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/classroom_selector/userCard.css">
    <link rel="stylesheet" href="/css/messages.css">
    <link rel="stylesheet" href="/css/classroom_selector/style.css">
    <link rel="stylesheet" href="/css/DropAndUpload.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">

</head>

<body>

    <nav style='background-color: #007bff' role="navigation">
        <div class="nav-wrapper ">
            <div class='left' style='color:white; font-size: 25px; margin-left:16px'>
                Dashboard
            </div>
            
                
                 
                    
                 
        
            <span class="profile-picture right" style='color:white; margin-right:16px; cursor: pointer;'>
                <i class='material-icons' style='font-size: 25px' onclick="Logout()">logout
                </i>
            </span>
            <span id="myUserName" class="right" style=' margin-right:16px;'></span>
            <a class="grey-text text-lighten-4 right" href="#!">
                <i class="material-icons right" style='color:white; margin-right: 16px'>
                    <i id='addGroup' style='font-size: 2.4rem' class="material-icons">add</i>
                </i>
            </a>
            <a class="grey-text text-lighten-4 right" href="/views/group" id="studentButton">
                <i class='material-icons' style='font-size: 25px'>user-group
                </i>
            </a>

           
        </div>

    </nav>


    

    <div id='insertClassroomsHere'>
    </div>

    <div class='card' id='editClassroom' style='left: 50%; top:45%; padding:12px; width:458px; position: absolute; z-index: 999; overflow-y: auto; display: none; background-color: white; transform:translate3d(-50%, -50%, 0)'>

        <span style='left:10px; top: 10px; font-size:24px; position: absolute;'>Edit
            Classroom</span>

        <form method='POST' action='/Pic/ClassroomPic' enctype="multipart/form-data" id='classroomPicForm'>
            <span style=' left:46%; top: 10px; font-size:24px; position: absolute;'>
                <label style="top: unset">
                    <div class="material-icons profile-picture">
                        <img id='editClassroomPic' style='width:40px; height:40px; cursor: pointer;'
                            src="/css/classroom_selector/card_background.png" />
                    </div>
                    <input name='ClassroomPic' id="file-input2" onchange="this.form.submit()" type="file" />
                </label>
            </span>
        </form>

        <a href="javascript:void(0);">
            <i id='closeEditClassroom' class="material-icons" style='font-size: 1.5rem; float: right; margin-right: 10px; margin-top: 5px'>close</i>
        </a>

        <form method='POST' action='/Classroom/Select/edit/' id='editClassroomForm'>

            <div class="input-field" style='margin-top: 50px'>
                <input type="text" name='ClassroomName' id="ClassroomName" required="required" />
                <label for="newClassroomSubject" style='color:rgba(44, 89, 172, 0.5)'>Classroom
                    Name</label>
            </div>

            <div class="input-field">
                <input type="text" name='Module' id="Module" required="required" />
                <label for="newClassroomSubject" style=' color:rgba(44, 89, 172, 0.5)'>Module</label>
            </div>

            <div class="input-field">
                <textarea class="materialize-textarea" name='ClassroomDescript' id="ClassroomDescript" required="required" /></textarea>
                <label for="ClassroomDescript" style=' color:rgba(44, 89, 172, 0.5)'>Classroom
                    Description</label>
            </div>
            <button id='ConfirmEditClassroom' type='submit' class='button' style='float:right; margin:20px;'>Update
                Classroom</button>

        </form>

        
    </div>
    <div class='card' id='newClassroom'>

        <span id='classroomHeading' style='left:10px; top: 10px; font-size: 24px ; position: absolute;'>New
            Group</span>
        <a href="javascript:void(0);">
            <i id='closeNewClassroom' class="material-icons" style='font-size: 1.8rem; float: right; margin-right: 10px;margin-top: 15px'>close</i>
        </a>
        <br /><br /><br />


        <div class="form-step js-form-step" data-step="1">

            <form id='newClassroomForm' class="col s12">
                <div id='error-Classroom' class='alert-block alert-danger' style='display : none; width:95%'> There is an error. </div>

                <div class="row" class='newClassroomInputs'>

                    <div class="input-field">
                        <input type="text" name='groupName' id="groupName" aria-required="true" required minlength='3' />
                        <label for="groupName">Group Name</label>
                    </div>
                    <div class="input-field">
                        <input type="number" name='groupID' id="groupID" aria-required="true" required minlength='6' />
                        <label for="groupID">Group Id</label>
                    </div>

                    <div class="input-field">
                        <input type="number" name='groupCapacity' id="groupCapacity" aria-required="true" required minlength='6' />
                        <label for="groupCapacity">Group Capacity</label>
                    </div>

                    <button id='ConfirmCreateClassroom' class="btn waves-effect waves-light btn-small" style='background-color: #4CAF50;float:right; margin-top:5px;'>Submit
                        <i class="material-icons right">send</i>
                    </button>
                </div>
            </form>

        </div>
    </div>



    <div id='overlay'></div>
    <div style='position: absolute; display:none; top:64px' id='overlay2'></div>




</body>

<script src="/js/config/port.js"></script>
<script src="/js/jquery.js"></script>
<script src='http://ajax.googleapis.com/ajax/libs/jqueryui/1.11.2/jquery-ui.min.js'></script>
<script src="/js/jquery.cookie.js"></script>
<script type="application/javascript" src="/js/dashboard.js"></script>
